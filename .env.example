# ---------- VPN (L2TP/IPsec) ----------
VPN_SERVER=vpn.example.com
VPN_USER=myuser
VPN_PASS=mypassword
# Leave empty for plain L2TP without IPsec
VPN_PSK=my_shared_secret
# Optional: IKE/ESP proposals, comma-separated, most preferred first (default covers
# AES-256/128 with SHA-256/SHA-1 and 3DES). Set when the log shows NO_PROPOSAL_CHOSEN.
VPN_IKE=
VPN_ESP=
# Optional: force DNS servers for vpn domains, space-separated (default: DNS pushed by the VPN server)
VPN_DNS=
# Seconds without VPN traffic before the VPN is disconnected
IDLE_TIMEOUT=300
# Seconds to wait for the VPN to come up
VPN_CONNECT_TIMEOUT=30

# ---------- Per-domain routing ----------
# Comma-separated lists.
#   .example.com or *.example.com -> example.com and every subdomain
#   example.com                   -> example.com only
# The longest match wins (e.g. .a.com=direct but .x.a.com=vpn).
ROUTE_VPN=.sub-1.example.com
ROUTE_DIRECT=.sub-2.example.com
ROUTE_BLOCK=
# Domains that match nothing: block | direct | vpn
ROUTE_DEFAULT=block
# Optional: DNS servers for direct domains (default: the container runtime's DNS)
DIRECT_DNS=

# ---------- Proxy ----------
PROXY_PORT=7998
# 1 = log every request with its route (vpn/direct/block)
LOG_REQUESTS=1
